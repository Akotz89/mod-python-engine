[worldserver]

###################################################################################################
#  PYTHON SETTINGS
#
#    Python.Enabled
#        Description: Enable or disable the Python scripting engine.
#        Default:     0 - Disabled
#                     1 - Enabled
#

Python.Enabled = 0

#
#    Python.ScriptsPath
#        Description: Absolute canonical root containing scripts. Relative paths, parent traversal,
#                     symlink components/entries, unreadable entries, and non-regular .py entries
#                     fail closed. Files load recursively in deterministic lexical order.
#        Default:     "" - no script root; enabling the engine fails script activation.
#

Python.ScriptsPath = ""

#
#    Python.CapabilityProfile
#        Description: Capability surface exported by the embedded module.
#                     safe-static-v1 exports immutable game constants only: no hook registration,
#                     native-object wrappers, state-mutating bindings, callback/hot-path dispatch,
#                     boolean vetoes, or administrative exec.
#                     unsafe-development-v1 preserves the legacy forwarded hooks and native
#                     bindings strictly for isolated development. It is outside production
#                     acceptance and requires both unsafe gates below.
#                     population-v1 exports only typed value snapshots and idempotent Playerbots
#                     lifecycle/CAS ports during one non-reentrant world-thread tick. It executes
#                     only Python.Population.EntryScript and fails closed on any error.
#        Default:     "safe-static-v1"
#

Python.CapabilityProfile = "safe-static-v1"

#
#    Python.Population.EntryScript
#        Description: Relative non-traversing Python file below Python.ScriptsPath used only by
#                     population-v1. No other .py file is executed directly.
#        Default:     ""
#

Python.Population.EntryScript = ""

#
#    Python.Population.MaxTickMilliseconds
#        Description: Post-call watchdog bound. In-process Python cannot be preempted while hung;
#                     acceptance must independently prove bounded callback behavior.
#        Default:     25
#

Python.Population.MaxTickMilliseconds = 25

#
#    Python.Population.OwnerCharacterGuid
#        Description: Authenticated human owner character used for earned high-water only. This
#                     character is never part of the immutable RNDBOT identity manifest.
#        Default:     0 - fail closed
#

Python.Population.OwnerCharacterGuid = 0

#
#    Python.Population.NativeOnlineLimit
#        Description: Native capacity ceiling independently enforced by the Playerbots bridge.
#                     It must remain below the durable 10000-identity roster.
#        Default:     0 - fail closed
#

Python.Population.NativeOnlineLimit = 0

#
#    Python.AllowUnsafeDevelopmentProfile
#        Description: First explicit gate for unsafe-development-v1.
#        Default:     0 - Disabled
#

Python.AllowUnsafeDevelopmentProfile = 0

#
#    Python.UnsafeDevelopmentAcknowledgement
#        Description: Second explicit gate for unsafe-development-v1. The exact development-only
#                     acknowledgement is documented in docs/capability-profiles.md. Never set it
#                     in a production configuration.
#        Default:     ""
#

Python.UnsafeDevelopmentAcknowledgement = ""

#
#    Python.AllowExecCommand
#        Description: Allow administrators and the server console to execute arbitrary Python
#                     in the worldserver process through the .python exec command. Ignored and the
#                     command is not registered unless unsafe-development-v1 passed both gates.
#        Default:     0 - Disabled
#                     1 - Enabled
#

Python.AllowExecCommand = 0

###################################################################################################
# LOGGING SETTINGS
#
#  Appender config values: Given an appender "name"
#    Appender.name
#        Description: Defines 'where to log'.
#        Format:      Type,LogLevel,Flags,optional1,optional2,optional3
#
#                     Type
#                         0 - (None)
#                         1 - (Console)
#                         2 - (File)
#                         3 - (DB)
#
#                     LogLevel
#                         0 - (Disabled)
#                         1 - (Fatal)
#                         2 - (Error)
#                         3 - (Warning)
#                         4 - (Info)
#                         5 - (Debug)
#                         6 - (Trace)
#
#                     Flags:
#                         0 - None
#                         1 - Prefix Timestamp to the text
#                         2 - Prefix Log Level to the text
#                         4 - Prefix Log Filter type to the text
#                         8 - Append timestamp to the log file name. Format: YYYY-MM-DD_HH-MM-SS
#                             (Only used with Type = 2)
#                        16 - Make a backup of existing file before overwrite
#                             (Only used with Mode = w)
#
#                     Colors (read as optional1 if Type = Console)
#                         Format: "fatal error warn info debug trace"
#                         0 - BLACK
#                         1 - RED
#                         2 - GREEN
#                         3 - BROWN
#                         4 - BLUE
#                         5 - MAGENTA
#                         6 - CYAN
#                         7 - GREY
#                         8 - YELLOW
#                         9 - LRED
#                        10 - LGREEN
#                        11 - LBLUE
#                        12 - LMAGENTA
#                        13 - LCYAN
#                        14 - WHITE
#                         Example: "1 9 3 6 5 8"
#
#                     File: Name of the file (read as optional1 if Type = File)
#                         Allows to use one "%s" to create dynamic files
#
#                     Mode: Mode to open the file (read as optional2 if Type = File)
#                          a - (Append)
#                          w - (Overwrite)
#
#                     MaxFileSize: Maximum file size of the log file before creating a new log file
#                     (read as optional3 if Type = File)
#                         Size is measured in bytes expressed in a 64-bit unsigned integer.
#                         Maximum value is 4294967295 (4 GB). Leave blank for no limit.
#                         NOTE: Does not work with dynamic filenames.
#                         Example:  536870912 (512 MB)
#

Appender.PythonConsole=1,4,0,"1 9 3 6 5 8"
Appender.PythonLog=2,5,0,Python.log,w

#  Logger config values: Given a logger "name"
#    Logger.name
#        Description: Defines 'What to log'
#        Format:      LogLevel,AppenderList
#
#                     LogLevel
#                         0 - (Disabled)
#                         1 - (Fatal)
#                         2 - (Error)
#                         3 - (Warning)
#                         4 - (Info)
#                         5 - (Debug)
#                         6 - (Trace)
#
#                     AppenderList: List of appenders linked to logger
#                     (Using spaces as separator).
#

Logger.module.python=4,PythonLog PythonConsole
